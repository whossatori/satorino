<?xml version="1.0" encoding="UTF-8"?>
<!-- satorino: rewritten for the satorino fork (this file still carried the
     stale Moltorino7 identity from the Moltorino7 -> leafyrino chain). The
     source file name is kept for merge reasons; the <id> matches the flatpak
     app-id and the installed desktop file name. -->
<component type="desktop-application">
    <id>dev.satorino.Satorino</id>
    <launchable type="desktop-id">dev.satorino.Satorino.desktop</launchable>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>MIT</project_license>
    <content_rating type="oars-1.0">
        <content_attribute id="social-chat">intense</content_attribute>
    </content_rating>
    <name>Satorino</name>
    <developer_name>satorino</developer_name>
    <summary>
        Chat client for Twitch
    </summary>
    <description>
        <p>
            Satorino is a personal fork of Leafyrino, itself a Chatterino 2
            fork combining features from Chatterino7, Moltorino7 and
            technorino, with additional Twitch, Kick and YouTube support.
        </p>
    </description>
    <keywords>
        <keyword>chat</keyword>
        <keyword>twitch</keyword>
    </keywords>
    <url type="homepage">https://github.com/satorino/satorino</url>
    <url type="bugtracker">https://github.com/satorino/satorino/issues</url>
    <provides>
        <binary>Satorino</binary>
    </provides>
    <releases>
        <release version="2.5.6" date="2026-11-01">
            <url>https://github.com/satorino/satorino/releases</url>
        </release>
    </releases>
</component>
